use Infrangible\CatalogProductPriceCalculation\Block\Product\Renderer\Listing\Simple;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Simple $block */

$product = $block->getListProduct();
?>
<?php if ($product !== null && $product->isAvailable()): ?>
    <script type="text/x-magento-init">
        {
            "[data-role=priceBox][data-price-box=product-id-<?= $escaper->escapeJs((string)$product->getId()) ?>]": {
                "priceBox": {
                    "priceConfig": <?= /* @noEscape */ $block->getPriceConfigJson() ?>
                }
            }
        }
    </script>
<?php endif; ?>
